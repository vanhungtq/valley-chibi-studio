{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "stage": {
      "type": "integer",
      "const": 0
    },
    "data": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "targetMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 1,
          "maxItems": 200
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "owner_provided",
                  "assumption",
                  "unknown"
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "minItems": 0,
                "maxItems": 200
              }
            },
            "required": [
              "statement",
              "status",
              "sourceIds"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 200
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 3,
          "maxItems": 200
        },
        "handoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "goal",
        "targetMinutes",
        "scope",
        "constraints",
        "assumptions",
        "facts",
        "questions",
        "acceptanceCriteria",
        "handoff"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "needs_revision",
            "needs_input"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "warning",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "warning"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "proposedFix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "severity",
              "field",
              "description",
              "proposedFix",
              "resolved"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "verdict",
        "round",
        "checks",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "data",
    "review"
  ],
  "additionalProperties": false
}
