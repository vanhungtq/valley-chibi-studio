{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "stage": {
      "type": "integer",
      "const": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "logline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "difference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "hook": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "motif": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "arc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "minItems": 3,
                "maxItems": 200
              },
              "ending": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "title",
              "logline",
              "difference",
              "hook",
              "motif",
              "arc",
              "ending"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 3
        },
        "selectedConceptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "selectionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "styleProfile": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "minItems": 2,
              "maxItems": 8
            },
            "camera": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "lighting": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "sound": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "wardrobe": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "minItems": 1,
              "maxItems": 200
            }
          },
          "required": [
            "palette",
            "camera",
            "lighting",
            "sound",
            "wardrobe",
            "avoid"
          ],
          "additionalProperties": false
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "handoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "concepts",
        "selectedConceptId",
        "selectionReason",
        "styleProfile",
        "props",
        "assumptions",
        "handoff"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "needs_revision",
            "needs_input"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "warning",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "warning"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "proposedFix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "severity",
              "field",
              "description",
              "proposedFix",
              "resolved"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "verdict",
        "round",
        "checks",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "data",
    "review"
  ],
  "additionalProperties": false
}
