{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "stage": {
      "type": "integer",
      "const": 2
    },
    "data": {
      "type": "object",
      "properties": {
        "beatMap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "sceneIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "minItems": 1,
                "maxItems": 40
              },
              "seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 14400
              }
            },
            "required": [
              "id",
              "title",
              "purpose",
              "sceneIds",
              "seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 40
        },
        "continuity": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "sceneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "entity",
              "sceneId",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "handoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "beatMap",
        "continuity",
        "assumptions",
        "handoff"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "needs_revision",
            "needs_input"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "warning",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "warning"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "proposedFix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "severity",
              "field",
              "description",
              "proposedFix",
              "resolved"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "verdict",
        "round",
        "checks",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "data",
    "review"
  ],
  "additionalProperties": false
}
