{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valley-chibi-studio",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "build": {"command": "npm run build:cloudflare"},
  "vars": {
    "PUBLIC_ORIGIN": "",
    "GITHUB_ALLOWED_LOGINS": "",
    "GITHUB_ALLOWED_IDS": ""
  },
  // deploy:cloudflare reuses existing D1/KV resources by exact default name.
  // Explicit database_id/id values take precedence, including custom-named resources.
  "d1_databases": [{"binding": "DB", "database_name": "valley-chibi-studio", "migrations_dir": "drizzle"}],
  // Workers Free: file contents and OAuth records use separate KV namespaces.
  "kv_namespaces": [{"binding": "OAUTH_KV"}, {"binding": "FILES_KV"}]
}
